{
  "name": "factory-testbed",
  "globIgnorePaths": ["core/src/testing/**"],
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "FactoryCore": {
        "$path": "core/src"
      },
      "TestbedServer": {
        "$path": "games/testbed/server"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "FactoryClient": {
        "$path": "core/client"
      },
      "FactoryKit": {
        "$path": "kit/src"
      },
      "TestbedShared": {
        "$path": "games/testbed/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TestbedClient": {
          "$path": "games/testbed/client"
        }
      }
    }
  }
}
